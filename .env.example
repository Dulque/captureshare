# Database connection (PostgreSQL for Neon/Supabase or SQLite for local)
DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET="your-jwt-secret-key"

# Object Storage (AWS S3 or Cloudflare R2 or Supabase S3)
STORAGE_PROVIDER="local" # Set to "s3" in production
S3_REGION="auto"
S3_BUCKET="trizen-photos"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_DOMAIN=""
